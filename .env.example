INVOICEIQ_APP_NAME=InvoiceIQ
INVOICEIQ_APP_VERSION=0.6.0
INVOICEIQ_ENVIRONMENT=development
INVOICEIQ_LOG_LEVEL=INFO
INVOICEIQ_DATABASE_URL=postgresql+psycopg://invoiceiq_app:CHANGE_ME@127.0.0.1:5433/invoiceiq
INVOICEIQ_UPLOAD_DIR=uploads
INVOICEIQ_MAX_UPLOAD_BYTES=10485760

